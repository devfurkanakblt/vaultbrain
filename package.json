{
  "name": "secondbrain-vault",
  "version": "0.2.0",
  "description": "A fast, local-first encrypted Markdown knowledge engine with controlled AI access, backlinks, history, attachments, templates, and portable YAML frontmatter.",
  "type": "module",
  "bin": {
    "sbrain": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/core.test.mjs test/documents.test.mjs test/workflows.test.mjs test/durability.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs --notes 1000 --assert",
    "benchmark:10k": "npm run build && node scripts/benchmark.mjs --notes 10000 --assert",
    "benchmark:100k": "npm run build && node scripts/benchmark.mjs --notes 100000 --assert",
    "fixtures": "npm run build && node scripts/make-fixtures.mjs",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "desktop:test": "vitest run --config desktop/vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@tauri-apps/api": "^2.11.1",
    "commander": "^12.1.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
