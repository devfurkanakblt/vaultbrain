{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main workspace may call only the narrow encrypted-vault command surface.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-pick-vault-directory",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-list-notes",
    "allow-get-note",
    "allow-save-note",
    "allow-create-note",
    "allow-rename-note",
    "allow-delete-note",
    "allow-list-deleted-notes",
    "allow-list-note-revisions",
    "allow-get-note-revision",
    "allow-restore-note-revision",
    "allow-list-templates",
    "allow-create-from-template",
    "allow-open-daily-note",
    "allow-list-plugins",
    "allow-authorize-plugin-instance",
    "allow-plugin-call",
    "allow-get-plugin",
    "allow-get-plugin-security-policy",
    "allow-set-plugin-restricted-mode",
    "allow-revoke-plugin-signer",
    "allow-restore-plugin-signer",
    "allow-install-plugin",
    "allow-set-plugin-enabled",
    "allow-delete-plugin",
    "allow-get-plugin-storage",
    "allow-set-plugin-storage",
    "allow-search-notes",
    "allow-get-backlinks",
    "allow-get-knowledge-graph",
    "allow-list-property-rows",
    "allow-update-note-property",
    "allow-list-saved-views",
    "allow-save-saved-view",
    "allow-delete-saved-view",
    "allow-get-workspace-state",
    "allow-save-workspace-state",
    "allow-get-unlinked-mentions",
    "allow-link-unlinked-mention",
    "allow-list-canvases",
    "allow-get-canvas",
    "allow-save-canvas",
    "allow-delete-canvas",
    "allow-add-attachment",
    "allow-read-attachment",
    "allow-list-attachments",
    "allow-delete-attachment",
    "allow-sync-status",
    "allow-sync-verify-registry"
  ]
}
